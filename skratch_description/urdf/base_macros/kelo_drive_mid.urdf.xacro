Using kelo drive wheels with some modifications to suit skratch bot
-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="kelo_drive_mid" params="name parent *origin movable_joints:=true">

        <xacro:include filename="$(find skratch_description)/urdf/base_macros/common.xacro" />
        <xacro:include filename="$(find skratch_description)/urdf/base_macros/kelo_drive_wheel.urdf.xacro" />

        <!-- PIVOT -->
        <xacro:if value="${movable_joints}">
            <joint name="${name}_pivot_joint" type="continuous">
                <xacro:insert_block name="origin" />
                <axis xyz="0 0 1"/>
                <parent link="${parent}"/>
                <child link="${name}_pivot_link" />
                <limit effort="2.0" velocity="1.0"/>
            </joint>

            <transmission name="${name}_pivot_transmission">
                <type>transmission_interface/SimpleTransmission</type>
                <joint name="${name}_pivot_joint">
                    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
                </joint>
                <actuator name="${name}_pivot_motor">
                    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
                    <mechanicalReduction>1</mechanicalReduction>
                </actuator>
            </transmission>

        </xacro:if>
        <xacro:unless value="${movable_joints}">
            <joint name="${name}_pivot_joint" type="fixed">
                <xacro:insert_block name="origin" />
                <axis xyz="0 0 1"/>
                <parent link="${parent}"/>
                <child link="${name}_pivot_link" />
            </joint>
        </xacro:unless>

        <link name="${name}_pivot_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find skratch_description)/meshes/kelo_drive/kelo_drive_mid_part.dae" scale="1 1 1"/>
                </geometry>
            </visual>

            <!--TODO: Set the correct collisions -->
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find skratch_description)/meshes/kelo_drive/kelo_drive_mid_part.dae" scale="1 1 1"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0.00023 -0.00095 0.04843" rpy="0 0 0"/>
                <mass value="1.46273"/>
                <inertia ixx="0.00302046423" ixy="0.00000851844" ixz="0.00001188180" iyy="0.00326495472" iyz="0.00001855408" izz="0.00386072964"/>
            </inertial>

            <!--TODO: Set the correct inertia-->
            <!-- <xacro:cuboid_inertia mass="10.0" length="0.233" breadth="0.233" height="0.233"/> -->
        </link>

        <!-- LEFT HUB WHEEL -->
        <xacro:kelo_drive_wheel name="${name}_left_hub_wheel" parent="${name}_pivot_link" movable_joints="${movable_joints}">
            <origin xyz="-0.01 0.039326 0.001514" rpy="0 0 0.0"/>
        </xacro:kelo_drive_wheel>

        <!-- RIGHT HUB WHEEL -->
        <xacro:kelo_drive_wheel name="${name}_right_hub_wheel" parent="${name}_pivot_link" movable_joints="${movable_joints}">
            <origin xyz="-0.01 -0.039326 0.001514" rpy="0 0 0.0"/>
        </xacro:kelo_drive_wheel>

    </xacro:macro>

</robot>
